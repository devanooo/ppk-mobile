rules_version = '2';

// Security Rules PraktikumKU.
// Sumber kebenaran: docs/sprints/sprint-2.md bagian 8.6 dan brief Sprint 2.
// Yang tidak bisa ditegakkan Security Rules (validasi lintas koleksi dan baca
// per field) ditegakkan di lapisan data dan UI, lihat catatan di 8.6.
//
// Aturan hanya diubah lewat PR, lalu deploy dengan:
//   npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Tolak semua yang tidak diizinkan secara eksplisit.
    match /{document=**} {
      allow read, write: if false;
    }

    function masuk() {
      return request.auth != null;
    }

    function peranSaya() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.peran;
    }

    function asisten() {
      return masuk() && peranSaya() == 'asisten';
    }

    function praktikan() {
      return masuk() && peranSaya() == 'praktikan';
    }

    // Praktikan terdaftar sebagai peserta kelas tertentu.
    function pesertaKelas(kelasId) {
      return masuk()
        && request.auth.uid in get(/databases/$(database)/documents/kelas/$(kelasId))
          .data.pesertaIds;
    }

    // ==== users ====
    // Baca: diri sendiri, atau asisten membaca profil praktikan. Rekap presensi
    // dan pemeriksaan izin menampilkan nama serta NIM (US-11 AC 2).
    // Batasan "hanya peserta kelasnya" tidak bisa ditegakkan di sini karena
    // rules tidak bisa query relasi kelas. Pembatasan ketat butuh salinan nama
    // dan nomorInduk di dokumen presensi dan izin.
    // Tulis: hanya diri sendiri; peran tidak boleh berubah setelah dibuat.
    // Registrasi mandiri boleh memilih peran praktikan atau asisten, verifikasi
    // akun asisten ditunda ke Sprint 3 (docs/sprints/sprint-2.md bagian 8.11).
    match /users/{userId} {
      allow get: if request.auth.uid == userId
        || (asisten() && resource.data.peran == 'praktikan');

      allow list: if asisten() && resource.data.peran == 'praktikan';

      allow create: if request.auth.uid == userId
        && request.resource.data.peran in ['praktikan', 'asisten']
        && request.resource.data.keys().hasAll(['nama', 'nomorInduk', 'peran', 'dibuatPada'])
        && request.resource.data.keys().hasOnly(['nama', 'nomorInduk', 'peran', 'dibuatPada']);

      allow update: if request.auth.uid == userId
        && request.resource.data.peran == resource.data.peran
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['nama', 'nomorInduk']);

      allow delete: if false;
    }

    // ==== kelas ====
    // Baca: asisten pengampu dan praktikan yang ada di pesertaIds.
    // Tulis: hanya asisten pengampu. Aturan "kelas dengan sesi tidak boleh
    // dihapus" dicek di lapisan data karena rules tidak bisa query koleksi sesi.
    match /kelas/{kelasId} {
      allow read: if masuk()
        && (resource.data.asistenId == request.auth.uid
          || request.auth.uid in resource.data.pesertaIds);

      allow create: if asisten()
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.keys().hasAll(
             ['nama', 'lab', 'asistenId', 'pesertaIds', 'dibuatPada'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.lab is string
        && request.resource.data.lab.size() > 0
        && request.resource.data.pesertaIds is list;

      allow update: if asisten()
        && resource.data.asistenId == request.auth.uid
        && request.resource.data.asistenId == request.auth.uid;

      allow delete: if asisten()
        && resource.data.asistenId == request.auth.uid;
    }

    // ==== sesi ====
    // Baca: asisten pengampu dan praktikan peserta kelasnya.
    // Create selalu "belum-dibuka". Transisi hanya belum-dibuka -> dibuka,
    // lalu dibuka -> ditutup. Sesi ditutup tidak dapat diubah lagi.
    match /sesi/{sesiId} {
      allow read: if masuk()
        && (resource.data.asistenId == request.auth.uid
          || pesertaKelas(resource.data.kelasId));

      allow create: if asisten()
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.status == 'belum-dibuka'
        && request.resource.data.keys().hasAll(
             ['kelasId', 'asistenId', 'hari', 'tanggal', 'jamMulai', 'jamSelesai',
              'status', 'dibuatPada'])
        && get(/databases/$(database)/documents/kelas/$(request.resource.data.kelasId))
             .data.asistenId == request.auth.uid;

      allow update: if asisten()
        && resource.data.asistenId == request.auth.uid
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.kelasId == resource.data.kelasId
        && (
          (resource.data.status == 'belum-dibuka'
            && request.resource.data.status in ['belum-dibuka', 'dibuka'])
          || (resource.data.status == 'dibuka'
            && request.resource.data.status in ['dibuka', 'ditutup'])
        );

      allow delete: if asisten()
        && resource.data.asistenId == request.auth.uid;

      // ==== sesi/{sesiId}/presensi ====
      // Create hanya praktikan pemilik, hanya saat sesi "dibuka", waktu wajib
      // timestamp server. Update dan delete ditolak.
      match /presensi/{praktikanId} {
        function sesiInduk() {
          return get(/databases/$(database)/documents/sesi/$(sesiId)).data;
        }

        allow read: if request.auth.uid == praktikanId
          || (asisten() && sesiInduk().asistenId == request.auth.uid);

        allow create: if request.auth.uid == praktikanId
          && request.resource.data.keys().hasAll(['praktikanId', 'waktu'])
          && request.resource.data.keys().hasOnly(['praktikanId', 'waktu'])
          && request.resource.data.praktikanId == praktikanId
          && request.resource.data.waktu == request.time
          && sesiInduk().status == 'dibuka'
          && pesertaKelas(sesiInduk().kelasId);

        allow update, delete: if false;
      }

      // ==== sesi/{sesiId}/izin ====
      match /izin/{praktikanId} {
        function sesiInduk() {
          return get(/databases/$(database)/documents/sesi/$(sesiId)).data;
        }

        function pemilik() {
          return request.auth.uid == praktikanId;
        }

        allow read: if pemilik()
          || (asisten() && sesiInduk().asistenId == request.auth.uid);

        // Praktikan pemilik saja, status awal "menunggu", hanya untuk sesi yang
        // belum ditutup dan kelas yang ia ikuti.
        allow create: if pemilik()
          && request.resource.data.keys().hasAll(
               ['praktikanId', 'alasan', 'status', 'klasifikasiStatus', 'dibuatPada'])
          && request.resource.data.keys().hasOnly(
               ['praktikanId', 'alasan', 'status', 'klasifikasiStatus', 'dibuatPada'])
          && request.resource.data.praktikanId == praktikanId
          && request.resource.data.status == 'menunggu'
          && request.resource.data.klasifikasiStatus == 'menunggu'
          && request.resource.data.dibuatPada == request.time
          && request.resource.data.alasan is string
          && request.resource.data.alasan.size() >= 5
          && request.resource.data.alasan.size() <= 500
          && sesiInduk().status != 'ditutup'
          && pesertaKelas(sesiInduk().kelasId);

        // Praktikan pemilik: hanya field hasil AI, hanya selama status masih
        // "menunggu", status izin tidak boleh berubah.
        // Asisten pengampu: hanya field keputusan, hanya dari "menunggu", dan
        // diputuskanOleh wajib dirinya sendiri.
        allow update: if (pemilik()
            && resource.data.status == 'menunggu'
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly(['kategoriAi', 'klasifikasiStatus', 'diprosesPada']))
          || (asisten()
            && sesiInduk().asistenId == request.auth.uid
            && resource.data.status == 'menunggu'
            && request.resource.data.status in ['disetujui', 'ditolak']
            && request.resource.data.diputuskanOleh == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly(['status', 'diputuskanPada', 'diputuskanOleh']));

        allow delete: if false;
      }
    }
  }
}
