# Salin file ini menjadi .env, lalu isi nilainya dari Firebase Console.
# Project Settings > General > Your apps > konfigurasi Web App.
# .env tidak boleh di-commit. Lihat docs/sprints/sprint-2.md bagian 8.7.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dipakai scripts/seed.mjs untuk membuat akun uji. Password minimal 6 karakter.
SEED_ASISTEN_1_EMAIL=
SEED_ASISTEN_1_PASSWORD=
SEED_ASISTEN_2_EMAIL=
SEED_ASISTEN_2_PASSWORD=
SEED_PRAKTIKAN_1_EMAIL=
SEED_PRAKTIKAN_1_PASSWORD=
